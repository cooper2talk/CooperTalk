+++ b/api/services/pipecat/cooper_events.py
@@ -0,0 +1,59 @@
+"""Best-effort, signed Cooper2Talk event delivery for live telephony runs."""
+
+import hashlib
+import hmac
+import json
+import os
+from datetime import UTC, datetime
+from typing import Any
+from uuid import uuid4
+
+import aiohttp
+from loguru import logger
+
+
+class CooperEventClient:
+    """Publish non-audio live events without ever blocking the voice pipeline."""
+
+    def __init__(self, workflow_run_id: int, call: dict[str, Any]):
+        self._workflow_run_id = workflow_run_id
+        self._call = call
+        self._endpoint = os.getenv("COOPER_EVENT_URL", "").strip()
+        self._secret = os.getenv("COOPER_EVENT_SECRET", "")
+
+    @property
+    def enabled(self) -> bool:
+        return bool(self._endpoint and len(self._secret) >= 16)
+
+    async def emit(self, event_type: str, payload: dict[str, Any] | None = None) -> None:
+        if not self.enabled:
+            return
+        event = {
+            "id": str(uuid4()),
+            "type": event_type,
+            "occurredAt": datetime.now(UTC).isoformat(timespec="milliseconds").replace("+00:00", "Z"),
+            "call": {
+                "dograhRunId": str(self._workflow_run_id),
+                **{key: value for key, value in self._call.items() if value is not None},
+            },
+        }
+        if payload:
+            event["payload"] = payload
+        raw = json.dumps(event, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
+        signature = hmac.new(self._secret.encode("utf-8"), raw, hashlib.sha256).hexdigest()
+        try:
+            timeout = aiohttp.ClientTimeout(total=2)
+            async with aiohttp.ClientSession(timeout=timeout) as session:
+                async with session.post(
+                    self._endpoint,
+                    data=raw,
+                    headers={"content-type": "application/json", "x-cooper-signature": f"sha256={signature}"},
+                ) as response:
+                    if response.status >= 300:
+                        logger.warning("Cooper2Talk event delivery failed: {}", response.status)
+        except Exception as exc:
+            logger.debug("Cooper2Talk event delivery skipped: {}", exc)
+
+    async def emit_transcript(self, *, speaker: str, text: str, interrupted: bool) -> None:
+        if text.strip():
+            await self.emit("transcript.final", {"speaker": speaker, "text": text, "interrupted": interrupted})
