diff --git a/api/services/configuration/managed_env.py b/api/services/configuration/managed_env.py
new file mode 100644
index 0000000..eb907d9
--- /dev/null
+++ b/api/services/configuration/managed_env.py
@@ -0,0 +1,36 @@
+"""Resolve Cooper2Talk-managed provider keys only inside the running API."""
+
+from __future__ import annotations
+
+import os
+
+from api.schemas.ai_model_configuration import EffectiveAIModelConfiguration
+
+MANAGED_API_KEY_MARKER = "cooper2talk-managed"
+
+_PROVIDER_ENVIRONMENT_KEYS = {
+    "deepgram": "DEEPGRAM_API_KEY",
+    "groq": "GROQ_API_KEY",
+    "rumik": "RUMIK_API_KEY",
+}
+
+
+def resolve_managed_api_keys(
+    configuration: EffectiveAIModelConfiguration,
+) -> EffectiveAIModelConfiguration:
+    """Replace the database marker with a runtime-only provider key."""
+
+    resolved = configuration.model_copy(deep=True)
+    for section in ("llm", "stt", "tts", "embeddings", "realtime"):
+        service = getattr(resolved, section, None)
+        if service is None or getattr(service, "api_key", None) != MANAGED_API_KEY_MARKER:
+            continue
+        provider = str(getattr(getattr(service, "provider", None), "value", ""))
+        environment_key = _PROVIDER_ENVIRONMENT_KEYS.get(provider)
+        if environment_key is None:
+            raise ValueError(f"Cooper2Talk does not manage credentials for {provider}.")
+        secret = os.getenv(environment_key)
+        if not secret:
+            raise ValueError(f"Missing required runtime secret: {environment_key}.")
+        service.api_key = secret
+    return resolved
