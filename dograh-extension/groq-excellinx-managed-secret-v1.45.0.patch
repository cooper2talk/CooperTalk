--- a/api/services/configuration/managed_env.py
+++ b/api/services/configuration/managed_env.py
@@ -7,29 +7,48 @@ import os
 from api.schemas.ai_model_configuration import EffectiveAIModelConfiguration
 
 MANAGED_API_KEY_MARKER = "cooper2talk-managed"
+EXCELLINX_GROQ_API_KEY_MARKER = "cooper2talk-managed:groq-excellinx"
 
-_PROVIDER_ENVIRONMENT_KEYS = {
-    "deepgram": "DEEPGRAM_API_KEY",
-    "groq": "GROQ_API_KEY",
-    "rumik": "RUMIK_API_KEY",
+_MANAGED_API_KEY_ENVIRONMENT_KEYS = {
+    MANAGED_API_KEY_MARKER: {
+        "deepgram": "DEEPGRAM_API_KEY",
+        "groq": "GROQ_API_KEY",
+        "rumik": "RUMIK_API_KEY",
+    },
+    EXCELLINX_GROQ_API_KEY_MARKER: {"groq": "GROQ_EXCELLINX_API_KEY"},
 }
 
 
+def managed_environment_key(api_key: str | None, provider: str) -> str | None:
+    """Return the runtime environment key for a safe Cooper2Talk marker."""
+
+    if api_key not in _MANAGED_API_KEY_ENVIRONMENT_KEYS:
+        return None
+    environment_key = _MANAGED_API_KEY_ENVIRONMENT_KEYS[api_key].get(provider)
+    if environment_key is None:
+        raise ValueError(
+            f"Cooper2Talk does not manage {provider} for marker {api_key}."
+        )
+    return environment_key
+
+
 def resolve_managed_api_keys(
     configuration: EffectiveAIModelConfiguration,
 ) -> EffectiveAIModelConfiguration:
-    """Replace the database marker with a runtime-only provider key."""
+    """Replace database markers with their runtime-only provider keys."""
 
     resolved = configuration.model_copy(deep=True)
     for section in ("llm", "stt", "tts", "embeddings", "realtime"):
         service = getattr(resolved, section, None)
-        if service is None or getattr(service, "api_key", None) != MANAGED_API_KEY_MARKER:
+        if service is None:
             continue
         provider = str(getattr(getattr(service, "provider", None), "value", ""))
-        environment_key = _PROVIDER_ENVIRONMENT_KEYS.get(provider)
-        if environment_key is None:
-            raise ValueError(f"Cooper2Talk does not manage credentials for {provider}.")
+        environment_key = managed_environment_key(
+            getattr(service, "api_key", None), provider
+        )
+        if environment_key is None:
+            continue
         secret = os.getenv(environment_key)
         if not secret:
             raise ValueError(f"Missing required runtime secret: {environment_key}.")
         service.api_key = secret
diff --git a/api/tests/test_managed_env.py b/api/tests/test_managed_env.py
new file mode 100644
index 0000000..48bd731
--- /dev/null
+++ b/api/tests/test_managed_env.py
@@ -0,0 +1,26 @@
+import pytest
+
+from api.services.configuration.managed_env import (
+    EXCELLINX_GROQ_API_KEY_MARKER,
+    MANAGED_API_KEY_MARKER,
+    managed_environment_key,
+)
+
+
+def test_managed_environment_key_resolves_existing_groq_key():
+    assert (
+        managed_environment_key(MANAGED_API_KEY_MARKER, "groq")
+        == "GROQ_API_KEY"
+    )
+
+
+def test_managed_environment_key_resolves_excellinx_groq_key():
+    assert (
+        managed_environment_key(EXCELLINX_GROQ_API_KEY_MARKER, "groq")
+        == "GROQ_EXCELLINX_API_KEY"
+    )
+
+
+def test_managed_environment_key_rejects_wrong_provider_for_excellinx_marker():
+    with pytest.raises(ValueError, match="does not manage deepgram"):
+        managed_environment_key(EXCELLINX_GROQ_API_KEY_MARKER, "deepgram")
