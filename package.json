{
  "name": "cooper2talk",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@cooper2talk/api",
    "dev:console": "npm run dev --workspace=@cooper2talk/console",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=@cooper2talk/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": { "node": ">=22" }
}
